// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE:
// This is a starter production schema.
// It includes RBAC foundation and core CMS entities.
// Extend as needed.

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id     String @id @default(uuid())
  roleId String

  fullName String
  email    String @unique
  password String

  designation String?
  shortBio    String?

  linkedin String?
  twitter  String?

  avatarMediaId String?

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  role Role @relation(fields: [roleId], references: [id])

  blogs         Blog[]
  refreshTokens RefreshToken[]
  uploadedMedia Media[]        @relation("UploadedMedia")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  blogVersions BlogVersion[]
  auditLogs    AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Media {
  id String @id @default(uuid())

  originalName String
  storedName   String
  s3Key        String
  mimeType     String
  fileSize     BigInt

  width  Int?
  height Int?

  altText String?
  caption String?

  uploadedById String
  uploadedBy   User   @relation("UploadedMedia", fields: [uploadedById], references: [id])

  featuredBlogs Blog[] @relation("FeaturedImage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

model Blog {
  id String @id @default(uuid())

  authorId        String
  featuredMediaId String?

  title   String
  slug    String  @unique
  excerpt String?
  content String

  status BlogStatus @default(DRAFT)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  // Post-content CTA card. Null falls back to the frontend's default copy
  // (see BlogDetail.jsx) — left as free-form fields, not auto-derived like
  // the SEO ones above, since there's no sensible per-post default to compute.
  ctaHeading       String?
  ctaDescription   String?
  ctaPrimaryText   String?
  ctaPrimaryUrl    String?
  ctaSecondaryText String?
  ctaSecondaryUrl  String?

  isFeatured    Boolean @default(false)
  allowComments Boolean @default(true)

  readingTime Int?
  views       Int  @default(0)

  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt  DateTime?

  author        User   @relation(fields: [authorId], references: [id])
  featuredMedia Media? @relation("FeaturedImage", fields: [featuredMediaId], references: [id])

  categories BlogCategory[]
  tags       BlogTag[]
  versions   BlogVersion[]
  faqs       BlogFaq[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("blogs")
}

model BlogFaq {
  id     String @id @default(uuid())
  blogId String

  question String
  answer   String
  position Int

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("blog_faqs")
}

model Category {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  // Marketing headline shown on the public category page, distinct from
  // `name` (which is used as the small eyebrow/pill label everywhere else).
  heading     String?
  description String?
  color       String?

  blogs BlogCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  blogs BlogTag[]

  createdAt DateTime @default(now())

  @@map("tags")
}

model NewsletterSubscriber {
  id    String @id @default(uuid())
  email String @unique

  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model BlogCategory {
  blogId     String
  categoryId String

  blog     Blog     @relation(fields: [blogId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([blogId, categoryId])
  @@map("blog_categories")
}

model BlogTag {
  blogId String
  tagId  String

  blog Blog @relation(fields: [blogId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([blogId, tagId])
  @@map("blog_tags")
}

model BlogVersion {
  id         String @id @default(uuid())
  blogId     String
  editedById String

  title   String
  excerpt String?
  content String

  blog     Blog @relation(fields: [blogId], references: [id])
  editedBy User @relation(fields: [editedById], references: [id])

  createdAt DateTime @default(now())

  @@map("blog_versions")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId String?

  ipAddress String?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Setting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       Json
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
