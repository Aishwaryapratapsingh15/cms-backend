# Copy this file to .env on the VPS and fill in real values.
# .env is gitignored — never commit real secrets.

PORT=3000
NODE_ENV=production

# --- Postgres container credentials (used by docker-compose's postgres service) ---
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=cms_db

# --- App DB connection (host must be the compose service name "postgres", not localhost) ---
DATABASE_URL="postgresql://cms_user:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/cms_db"

# --- Auth ---
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- AWS S3 + CloudFront (Media module) — optional, app boots fine without these ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_DOMAIN=

# --- Optional ---
PUBLIC_SITE_URL=
# Set to your real domain(s) before going live, e.g. https://cms.example.com
CORS_ORIGINS=
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
